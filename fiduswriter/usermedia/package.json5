{
    scripts: {
        copy_croppedjs_css: "mkdir -p ../static-libs/css/ && (cp --preserve=mode node_modules/cropperjs/dist/cropper.min.css ../static-libs/css/ 2>/dev/null || echo 'Cropper CSS not found, skipping.')",
        postinstall: "npm run copy_croppedjs_css"
    },

    dependencies: {
        cropperjs: "^1.5.9"
    }
}
